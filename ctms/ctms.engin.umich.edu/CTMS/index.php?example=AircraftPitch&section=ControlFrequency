        <li><a href="?aux=Extras_Leadlag">Lead/Lag Freq Resp</a></li>
      </ul>
	  <h3>Related External Links</h3>
      <ul>
	    <li><a href="https://www.mathworks.com/videos/using-bode-plots-lead-lag-pid-controllers-4-of-5-77061.html">Bode MATLAB Video</a></li>
