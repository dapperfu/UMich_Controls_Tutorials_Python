      <h2>Contents</h2>
      <div>
         <ul>
            <li><a href="#1">Physical setup</a></li>
            <li><a href="#2">Create world frame and basic configuration</a></li>
            <li><a href="#3">Assemble the gear</a></li>
            <li><a href="#7">Add the lever</a></li>
            <li><a href="#10">Add the beam</a></li>
