within UMichControls;
package Introduction "Introduction examples: mass-spring-damper and magnetic suspension"
  extends Modelica.Icons.ExamplesPackage;
  
  annotation(
    Documentation(info="<html>
    <p>This package contains introductory control system examples:</p>
    <ul>
      <li>MassSpringDamper: A simple mechanical system with mass, spring, and damper</li>
      <li>MagneticSuspension: A magnetically suspended ball system</li>
    </ul>
    </html>"));
end Introduction;

