within UMichControls;
package CruiseControl "Cruise control system: vehicle speed control"
  extends Modelica.Icons.ExamplesPackage;
  
  annotation(
    Documentation(info="<html>
    <p>This package contains models for the cruise control system example.
    The cruise control system maintains constant vehicle speed despite
    external disturbances such as changes in wind or road grade.</p>
    </html>"));
end CruiseControl;

